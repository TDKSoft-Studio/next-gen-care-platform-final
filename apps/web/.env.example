# Required only to start the CMS locally or in an approved environment. Never commit real values.
DATABASE_URL=postgresql://cms_user:change-me@localhost:5432/next_gen_care_cms
PAYLOAD_SECRET=generate-a-long-random-secret-before-use
PREVIEW_SECRET=generate-a-separate-long-random-secret-before-use
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Production only: a named, approved HTTPS domain plus an explicit release gate.
NEXT_PUBLIC_SITE_URL=
PUBLIC_SEO_ENABLED=false
# Server-only URL for the accepted appointment API contract. Do not expose this in client bundles.
APPOINTMENT_API_URL=http://localhost:8080

{
  "name": "next-gen-care-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEXT GEN CARE application workspace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "pnpm --filter @next-gen-care/web build",
    "ci": "task ci",
    "dev": "pnpm --filter @next-gen-care/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && node scripts/check-package-boundaries.mjs",
    "performance": "node scripts/check-performance-budget.mjs",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "security:sast": "eslint . --max-warnings=0",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:contract": "node scripts/check-phase-gate.mjs contract",
    "test:e2e": "playwright test",
    "test:http": "node scripts/check-production-http.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cyclonedx/cdxgen": "12.8.4",
    "@eslint/compat": "2.1.0",
    "@go-task/cli": "3.53.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-security": "4.0.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
